# Real LLM assistant + AI suggestions. Get a key at https://console.anthropic.com
# then copy this file to .env.local and restart the dev server.
ANTHROPIC_API_KEY=

# --- Cloud deploy only (Vercel + Upstash Redis) ---
# Local dev does NOT need these — the demo store falls back to a local file.
# In the cloud these make the live demo store shared across all visitors.
# Vercel's Upstash integration injects them automatically; either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
